APP_NAME="Brasil em Perspectiva"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dashboard.stolner.com
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# Local CLI uses Laravel's default database/database.sqlite.
# Compose overrides this with /var/www/html/storage/app/atlas.sqlite.

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
MAIL_FROM_ADDRESS="dashboard@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Generate caches only at container startup, with runtime configuration.
DEPLOY_CACHE=false
# Optional Compose tunnel profile reads a real token from this file.
CLOUDFLARE_TUNNEL_TOKEN_FILE=./deploy/secrets/tunnel-token
